# PostgreSQL connection string (Neon serverless).
# Get one free at https://neon.tech — copy the "pooled" connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret for signing session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic API key for the AI repair assistant.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."
